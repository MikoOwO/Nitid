---
import Logo from './Logo.astro';

const { t } = Astro.props;
const f = t.contact.fields;
// Adresse du service de formulaire (Formspree, Web3Forms…). Vide : le formulaire ouvre un email prérempli.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---

<section id="contact" class="contact" aria-labelledby="contact-titre">
  <div class="wrap contact__inner">
    <div class="contact__grid">
      <div class="contact__intro" data-reveal>
        <h2 id="contact-titre" class="serif h2">{t.contact.title}</h2>
        <p>{t.contact.lead}</p>
        <div class="contact__direct">
          <span>{t.contact.direct}</span>
          <a href={`tel:${t.contact.phoneHref}`}>{t.contact.phone}</a>
          <a href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
        </div>
      </div>

      <form class="form" data-form data-endpoint={endpoint} data-email={t.contact.email} data-sending={t.contact.sending} data-success={t.contact.success} data-error={t.contact.error} novalidate data-reveal>
        <div class="row">
          <label>
            <span>{f.name}</span>
            <input name="nom" autocomplete="name" required />
          </label>
          <label>
            <span>{f.company}</span>
            <input name="entreprise" autocomplete="organization" required />
          </label>
        </div>
        <div class="row">
          <label>
            <span>{f.email}</span>
            <input name="email" type="email" autocomplete="email" inputmode="email" required />
          </label>
          <label>
            <span>{f.phone} <em>({f.optional})</em></span>
            <input name="telephone" type="tel" autocomplete="tel" inputmode="tel" />
          </label>
        </div>
        <label>
          <span>{f.website} <em>({f.optional})</em></span>
          <input name="site" type="url" inputmode="url" placeholder="https://" />
        </label>
        <label>
          <span>{f.activity}</span>
          <input name="activite" required placeholder={f.activityPlaceholder} />
        </label>
        <label class="hp" aria-hidden="true">
          <span>Ne pas remplir</span>
          <input name="botcheck" tabindex="-1" autocomplete="off" />
        </label>
        <div class="form__end">
          <button class="btn" type="submit">{t.contact.submit}</button>
          <p class="form__note">{t.contact.below}</p>
        </div>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>

    <footer class="footer">
      <span class="footer__brand">
        <span class="footer__logo"><Logo size={17} /><span class="serif">Nitid</span></span>
        <span>{t.footer.signature}</span>
      </span>
      <span class="footer__links">
        <a href="/mentions-legales">{t.footer.legal}</a>
        <a href="/confidentialite">{t.footer.privacy}</a>
        <span>{t.footer.made} © {new Date().getFullYear()} Nitid</span>
      </span>
    </footer>
  </div>
</section>

<style>
  .contact {
    background: var(--contact-bg);
    color: var(--contact-fg);
  }
  .contact__inner {
    padding-block: clamp(88px, 10vw, 120px) 48px;
    display: flex;
    flex-direction: column;
    gap: clamp(72px, 9vw, 104px);
  }
  .contact__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 56px 80px;
    align-items: flex-start;
  }
  .contact__intro {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .contact__intro h2 {
    font-size: clamp(38px, 5vw, 70px);
    line-height: 1;
  }
  .contact__intro p {
    margin: 0;
    max-width: 460px;
    font-size: 18px;
    color: var(--contact-muted);
  }
  .contact__direct {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 12px;
    font-size: 15px;
    color: var(--contact-muted);
  }
  .contact__direct a {
    color: var(--contact-fg);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    width: fit-content;
  }
  .contact__direct a:hover {
    text-decoration: underline;
  }

  .form {
    flex: 1.2 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 18px;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    color: var(--contact-muted);
  }
  label em {
    font-style: normal;
    opacity: 0.75;
  }
  input {
    width: 100%;
    min-height: 52px;
    padding: 0 16px;
    border: 1px solid var(--field-border);
    border-radius: 10px;
    background: var(--field-bg);
    color: var(--contact-fg);
    font: inherit;
    font-size: 16px;
    font-weight: 400;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  input::placeholder {
    color: var(--contact-muted);
    opacity: 0.6;
  }
  input:focus {
    outline: none;
    border-color: var(--contact-fg);
    background: rgba(255, 255, 255, 0.08);
  }
  input[aria-invalid='true'] {
    border-color: #f2a7a7;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    padding-top: 8px;
  }
  .form .btn {
    background: linear-gradient(180deg, #ffffff 0%, #e6e8ee 100%);
    color: #14171a;
    box-shadow: 0 0 28px rgba(160, 180, 255, 0.25);
  }
  .form .btn[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .form__note {
    margin: 0;
    font-size: 14px;
    color: var(--contact-muted);
  }
  .form__status {
    margin: 0;
    min-height: 1.6em;
    font-size: 15px;
    color: var(--contact-fg);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    padding-top: 28px;
    border-top: 1px solid var(--contact-line);
    font-size: 14px;
    color: var(--contact-muted);
  }
  .footer__brand,
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--contact-fg);
  }
  .footer__logo .serif {
    font-size: 20px;
    letter-spacing: 0.05em;
  }
  .footer a {
    color: var(--contact-muted);
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--contact-fg);
    text-decoration: underline;
  }
</style>
