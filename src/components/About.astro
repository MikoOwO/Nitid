---
const { t } = Astro.props;
---

<section class="section about" aria-labelledby="equipe-titre">
  <div class="wrap about__inner" data-reveal>
    <h2 id="equipe-titre" class="serif h2">{t.about.title}</h2>
    <div class="about__text">
      <p>{t.about.text}</p>
      <a href={t.about.linkUrl} target="_blank" rel="noopener">{t.about.link} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--section-bg);
  }
  .about__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 80px;
    align-items: flex-start;
  }
  .about h2 {
    flex: 1 1 320px;
    min-width: 0;
  }
  .about__text {
    flex: 1.3 1 420px;
    min-width: 0;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .about__text p {
    margin: 0;
    font-size: 20px;
    line-height: 1.6;
    color: var(--fg-2);
  }
  .about__text a {
    font-weight: 400;
  }
</style>
