---
const { t } = Astro.props;
---

<section id="realisations" class="section work" aria-labelledby="realisations-titre">
  <div class="wrap work__inner">
    <h2 id="realisations-titre" class="serif h2" data-reveal>{t.work.title}</h2>
    <ul class="work__list">
      {
        t.work.items.map((it: { name: string; url: string; d: string }) => (
          <li data-reveal>
            <a href={it.url} target="_blank" rel="noopener">
              <span class="work__name serif">{it.name}</span>
              <span class="work__desc">{it.d}</span>
              <span class="work__go" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work {
    background: var(--bg);
  }
  .work__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .work__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }
  .work__list li {
    border-bottom: 1px solid var(--line-strong);
  }
  .work__list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) auto;
    gap: 12px 40px;
    align-items: center;
    padding: 30px 0;
    text-decoration: none;
  }
  .work__name {
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.05;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .work__desc {
    color: var(--muted);
  }
  .work__go {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.3s ease;
  }
  .work__list a:hover {
    color: var(--fg);
  }
  .work__list a:hover .work__name {
    transform: translateX(10px);
  }
  .work__list a:hover .work__go {
    transform: rotate(45deg);
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .work__list a {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .work__desc {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
