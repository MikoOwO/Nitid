---
const { t } = Astro.props;
---

<section class="section deliver" aria-labelledby="recevez-titre">
  <div class="wrap deliver__inner">
    <h2 id="recevez-titre" class="serif h2" data-reveal>{t.deliver.title}</h2>
    <ul class="grid">
      {
        t.deliver.items.map((it: { t: string; d: string }, i: number) => (
          <li data-reveal style={`transition-delay:${i * 0.1}s`}>
            <span class="index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{it.t}</h3>
            <p>{it.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .deliver {
    background: var(--bg);
  }
  .deliver__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .grid li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 28px 36px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .index {
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--tag);
  }
  h3 {
    margin: 0;
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
</style>
