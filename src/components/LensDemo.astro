---
// Démonstration signature : le site daté et flou d'une menuiserie fictive ; la loupe révèle la nouvelle version.
interface Props {
  label: string;
  hintHover: string;
  hintTouch: string;
  fictional: string;
}
const { label, hintHover, hintTouch, fictional } = Astro.props;
---

<figure class="demo">
  <div class="frame">
    <div class="frame__bar">
      <div class="frame__dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="frame__url">menuiserie-lorin.ch</div>
    </div>

    <div class="lens" data-lens role="img" aria-label={label}>
      <!-- Avant : site daté, flou -->
      <div class="old" aria-hidden="true">
        <div class="old__head">
          <div class="old__brand">MENUISERIE LORIN</div>
          <div class="old__tagline">Menuiserie - Ébénisterie - Escaliers - Cuisines</div>
        </div>
        <div class="old__nav"><span>Accueil</span><span>|</span><span>Nos réalisations</span><span>|</span><span>Devis</span><span>|</span><span>Plan d’accès</span></div>
        <div class="old__body">
          <div class="old__side">
            <div class="old__side-title">Liens utiles</div>
            <div class="old__link">» Nos horaires</div>
            <div class="old__link">» Livre d’or</div>
            <div class="old__link">» Contactez-nous</div>
          </div>
          <div class="old__main">
            <div class="old__h">Bienvenue !</div>
            <div class="old__p">La Menuiserie Lorin vous accueille depuis 1987. Nous réalisons tous travaux de menuiserie et d’ébénisterie. N’hésitez pas à nous contacter pour un devis gratuit !!</div>
            <div class="old__img">photo_atelier_2008.jpg</div>
          </div>
        </div>
        <div class="old__foot">© 2009 Menuiserie Lorin - Site optimisé pour Internet Explorer 6 en 1024x768</div>
      </div>

      <!-- Après : nouvelle version, nette, sous la loupe -->
      <div class="new" aria-hidden="true">
        <div class="new__nav">
          <div class="new__brand">Lorin</div>
          <div class="new__links"><span>Réalisations</span><span>Savoir-faire</span><span>Devis</span></div>
        </div>
        <div class="new__body">
          <div class="new__copy">
            <div class="new__h">Le bois, travaillé au millimètre.</div>
            <div class="new__p">Escaliers, cuisines et agencements sur mesure, depuis 1987.</div>
            <div><span class="new__btn">Demander un devis</span></div>
          </div>
          <div class="new__wood"></div>
        </div>
      </div>

      <div class="ring" aria-hidden="true"></div>
      <div class="ring__glow" aria-hidden="true"></div>
      <span class="mark mark--tl" aria-hidden="true"></span>
      <span class="mark mark--tr" aria-hidden="true"></span>
      <span class="mark mark--bl" aria-hidden="true"></span>
      <span class="mark mark--br" aria-hidden="true"></span>
    </div>
  </div>
  <figcaption>
    <span><span class="hint hint--hover">{hintHover}</span><span class="hint hint--touch">{hintTouch}</span></span>
    <span>{fictional}</span>
  </figcaption>
</figure>

<style>
  .demo {
    flex: 1.4 1 520px;
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .frame {
    border-radius: 12px;
    overflow: hidden;
    background: var(--frame-bg);
    box-shadow: var(--frame-shadow);
  }
  .frame__bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    background: var(--frame-bg);
    border-bottom: 1px solid var(--frame-line);
  }
  .frame__dots {
    display: flex;
    gap: 6px;
  }
  .frame__dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--frame-dot);
  }
  .frame__url {
    flex: 1;
    min-width: 0;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--frame-url-bg);
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lens {
    --lx: 38%;
    --ly: 50%;
    position: relative;
    aspect-ratio: 16 / 10;
    max-width: 100%;
    container-type: inline-size;
    overflow: hidden;
    cursor: crosshair;
    touch-action: pan-y;
    background: #ffffff;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ----- Avant ----- */
  .old {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    color: #333333;
    font-family: Verdana, Geneva, sans-serif;
    font-weight: 400;
    line-height: 1.3;
    filter: blur(0.16cqw);
  }
  .old__head {
    display: flex;
    flex-direction: column;
    gap: 0.6cqw;
    padding: 2.2cqw 3cqw;
    background: linear-gradient(180deg, #6c9bd2 0%, #2f5f98 100%);
    border-bottom: 0.5cqw solid #f2c94c;
  }
  .old__brand {
    font-family: 'Comic Sans MS', 'Comic Sans', 'Chalkboard SE', cursive;
    font-size: 4.4cqw;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #ffffff;
    text-shadow: 0.25cqw 0.25cqw 0 #1c3a5e;
  }
  .old__tagline {
    font-size: 1.7cqw;
    color: #fff6c8;
  }
  .old__nav {
    display: flex;
    gap: 1.6cqw;
    padding: 1cqw 3cqw;
    background: #dce6f1;
    border-bottom: 0.15cqw solid #9fb4cf;
    font-size: 1.6cqw;
    color: #0033cc;
    text-decoration: underline;
  }
  .old__body {
    flex: 1;
    display: flex;
    gap: 2.4cqw;
    padding: 2.4cqw 3cqw;
  }
  .old__side {
    flex: none;
    width: 20cqw;
    display: flex;
    flex-direction: column;
    gap: 0.8cqw;
    padding: 1.4cqw;
    background: #efefef;
    border: 0.15cqw solid #cccccc;
    font-size: 1.5cqw;
  }
  .old__side-title {
    font-weight: 700;
    color: #993300;
  }
  .old__link {
    color: #0033cc;
    text-decoration: underline;
  }
  .old__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2cqw;
  }
  .old__h {
    font-family: 'Times New Roman', Times, serif;
    font-size: 3.2cqw;
    font-weight: 700;
    color: #993300;
  }
  .old__p {
    font-family: 'Times New Roman', Times, serif;
    font-size: 1.9cqw;
    line-height: 1.35;
    color: #444444;
  }
  .old__img {
    height: 13cqw;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fafafa;
    border: 0.2cqw dashed #aaaaaa;
    font-size: 1.5cqw;
    color: #888888;
  }
  .old__foot {
    padding: 1cqw 3cqw;
    border-top: 0.15cqw solid #dddddd;
    font-size: 1.25cqw;
    color: #888888;
    text-align: center;
  }

  /* ----- Après ----- */
  .new {
    position: absolute;
    inset: 0;
    clip-path: circle(17cqw at var(--lx) var(--ly));
    display: flex;
    flex-direction: column;
    gap: 3cqw;
    padding: 3cqw 4cqw;
    background: radial-gradient(ellipse 70% 60% at 85% 20%, rgba(214, 170, 120, 0.18), rgba(0, 0, 0, 0) 60%), #1f160f;
    color: #f2e8da;
    font-family: 'Jost Variable', 'Jost', sans-serif;
    font-weight: 400;
    line-height: 1.4;
  }
  .new__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2cqw;
  }
  .new__brand {
    font-family: 'Bodoni Moda Variable', Georgia, serif;
    font-size: 2.8cqw;
  }
  .new__links {
    display: flex;
    gap: 2.4cqw;
    font-size: 1.45cqw;
    color: #cdbba6;
  }
  .new__body {
    flex: 1;
    display: flex;
    gap: 3cqw;
    align-items: center;
  }
  .new__copy {
    flex: 1.1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2cqw;
  }
  .new__h {
    font-family: 'Bodoni Moda Variable', Georgia, serif;
    font-size: 6cqw;
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .new__p {
    max-width: 34cqw;
    font-size: 1.75cqw;
    line-height: 1.5;
    color: #cdbba6;
  }
  .new__btn {
    display: inline-block;
    padding: 1.2cqw 2.2cqw;
    border-radius: 999px;
    background: #ebd9bf;
    color: #1f160f;
    font-size: 1.55cqw;
    font-weight: 500;
  }
  .new__wood {
    flex: 0.9;
    min-width: 0;
    align-self: stretch;
    border-radius: 1.2cqw;
    background:
      radial-gradient(ellipse 3.5cqw 6cqw at 32% 62%, rgba(46, 24, 10, 0.6), rgba(46, 24, 10, 0) 70%),
      radial-gradient(ellipse 2.5cqw 4cqw at 70% 25%, rgba(46, 24, 10, 0.45), rgba(46, 24, 10, 0) 70%),
      repeating-linear-gradient(91deg, rgba(0, 0, 0, 0.13) 0, rgba(0, 0, 0, 0.13) 0.22cqw, rgba(0, 0, 0, 0) 0.22cqw, rgba(0, 0, 0, 0) 1.4cqw),
      repeating-linear-gradient(88deg, rgba(255, 235, 205, 0.06) 0, rgba(255, 235, 205, 0.06) 0.12cqw, rgba(0, 0, 0, 0) 0.12cqw, rgba(0, 0, 0, 0) 2.3cqw),
      linear-gradient(160deg, #9a6a41 0%, #6e4528 55%, #4e3019 100%);
  }

  /* ----- Loupe ----- */
  .ring,
  .ring__glow {
    position: absolute;
    left: var(--lx);
    top: var(--ly);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
  }
  .ring__glow {
    width: 34cqw;
    height: 34cqw;
    box-shadow: var(--ring-glow);
  }
  .ring {
    width: 36cqw;
    height: 36cqw;
    background: var(--ring);
    -webkit-mask: radial-gradient(circle, rgba(0, 0, 0, 0) 0 16.9cqw, #000 17cqw 17.9cqw, rgba(0, 0, 0, 0) 18cqw);
    mask: radial-gradient(circle, rgba(0, 0, 0, 0) 0 16.9cqw, #000 17cqw 17.9cqw, rgba(0, 0, 0, 0) 18cqw);
  }
  .mark {
    display: var(--marks);
    position: absolute;
    width: 3.4cqw;
    height: 3.4cqw;
    border: 0 solid var(--accent);
    pointer-events: none;
  }
  .mark--tl {
    left: calc(var(--lx) - 20cqw);
    top: calc(var(--ly) - 20cqw);
    border-top-width: 0.4cqw;
    border-left-width: 0.4cqw;
  }
  .mark--tr {
    left: calc(var(--lx) + 16.6cqw);
    top: calc(var(--ly) - 20cqw);
    border-top-width: 0.4cqw;
    border-right-width: 0.4cqw;
  }
  .mark--bl {
    left: calc(var(--lx) - 20cqw);
    top: calc(var(--ly) + 16.6cqw);
    border-bottom-width: 0.4cqw;
    border-left-width: 0.4cqw;
  }
  .mark--br {
    left: calc(var(--lx) + 16.6cqw);
    top: calc(var(--ly) + 16.6cqw);
    border-bottom-width: 0.4cqw;
    border-right-width: 0.4cqw;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }
  .hint--touch {
    display: none;
  }
  @media (hover: none) {
    .hint--hover {
      display: none;
    }
    .hint--touch {
      display: inline;
    }
  }
</style>
